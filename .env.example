# Bind address and port for the FlareSolverr-compatible service.
PROWL_HOST=0.0.0.0
PROWL_PORT=8191
# Maximum number of browser fetches executed concurrently. This stack owns one
# persistent trust profile and one free browser session, so 1 is the default.
PROWL_MAX_CONCURRENCY=1
# Maximum number of logical sessions kept alive at once. A logical session is a
# name/TTL over the shared profile, not a separate browser.
PROWL_MAX_SESSIONS=32
# Process-wide egress proxy for the browser, applied as Chromium --proxy-server.
# Optional. When set, a request may only name the same proxy. Embedded
# credentials are rejected; use a local credential-injecting proxy when needed.
# Leave unset to use the container's network directly.
# PROWL_PROXY_URL=socks5://127.0.0.1:1080
# Directory holding the persistent browser trust profile, and the archive the
# profile is packed into on shutdown. Both must live on the same writable,
# persistent volume; keep the archive outside the profile directory.
PROWL_PROFILE_DIR=/state/profile
PROWL_PROFILE_ARCHIVE=/state/browser-profile.zip
# X display used by the headed browser inside the container.
DISPLAY=:0
