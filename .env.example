# Bind address and port for the FlareSolverr-compatible service.
PROWL_HOST=0.0.0.0
PROWL_PORT=8191
# Maximum number of browser operations executed concurrently: a fetch, a browser.open, and a
# cookies.list each take one slot. It is also the capacity at which an open interactive tab may be
# taken over, so open tabs and in-flight operations count together against it. This stack owns one
# persistent trust profile and one free browser session, so 1 is the default.
PROWL_MAX_CONCURRENCY=1
# Maximum number of logical sessions kept alive at once. A logical session is a
# name/TTL over the shared profile, not a separate browser.
PROWL_MAX_SESSIONS=32
# Process-wide egress proxy for the browser, applied as Chromium --proxy-server.
# Optional. This egress is named "default". A request may name it by url, or select
# another configured egress. Embedded credentials are rejected; use a local
# credential-injecting proxy when needed. Leave unset to use the container's network.
# PROWL_PROXY_URL=socks5://127.0.0.1:1080
# Additional named egresses, as a comma separated name=url list. Each one owns its own
# browser process, profile directory, and profile archive, so it keeps its own warm trust
# and cookies. Names may use letters, digits, dot, dash, and underscore; "default" is
# reserved for PROWL_PROXY_URL.
# PROWL_EGRESSES=decodo=socks5://127.0.0.1:10001,warp=socks5://127.0.0.1:10002
# How long a named egress browser may stay idle before it is shut down, in seconds.
# PROWL_EGRESS_IDLE_SECONDS=300
# How long an interactive tab opened with browser.open may go untouched before it is closed,
# in seconds. Unset or 0 keeps it open until it is closed explicitly, which is the default
# because a person is driving the tab. browser.list refreshes the countdown only for the tab
# it names, so a client that is displaying the tab keeps it alive.
PROWL_INTERACTIVE_IDLE_SECONDS=0
# Whether an interactive tab may be taken over when the browser is at capacity. On by default, and
# only ever at capacity: when open tabs plus in-flight operations reach PROWL_MAX_CONCURRENCY,
# opening another tab or running a fetch first closes the least recently used tab, but never the
# only one, because a lone tab is the one a person is most likely watching. browser.list refreshes
# the position of the tab it names, so a client displaying a tab protects it. Set to 0 to keep
# every tab until its idle timeout or an explicit browser.close.
PROWL_STEAL_LEAST_RECENT=true
# Directory holding the persistent browser trust profile, and the archive the
# profile is packed into on shutdown. Both must live on the same writable,
# persistent volume; keep the archive outside the profile directory.
PROWL_PROFILE_DIR=/state/profile
PROWL_PROFILE_ARCHIVE=/state/browser-profile.zip
# Optional. A directory of unpacked Chromium extensions, read at launch, so a change needs a
# restart. Each subdirectory holding a manifest.json is one extension; the directory name may
# differ from the extension's own name. A modern Chromium does not run Manifest V2 extensions,
# so uBlock Origin Lite is the one that works rather than the original. An extension is visible
# to the pages it runs on, which adds a fingerprinting surface; weigh that against a browser
# whose value is passing bot checks.
# PROWL_EXTENSIONS_DIR=/extensions
# Optional. A directory of managed policy JSON files, applied at launch to the policy
# directories Chromium reads. Policies can pin an extension to the toolbar and set which hosts
# it may touch through ExtensionSettings, but they cannot grant a permission a user normally
# grants by clicking, such as uBlock Origin Lite's "Allow User Scripts". That value lives in the
# profile, and a click inside the browser is remembered across restarts because Prowl packs and
# unpacks its profile. See the README for the full limits.
# PROWL_POLICY_DIR=/policies
# Optional. The size the browser window is launched at, as WIDTHxHEIGHT. Unset, the window is
# launched at the fingerprint screen size, which is a persona property and may be larger than the
# display the browser is shown on. Setting it also sets the page viewport and the screen size the
# page reports to the same value, so the window, the viewport, and the screen agree instead of the
# page laying out wider than the window; it is not an anti-fingerprinting measure. A window is
# always placed at the origin, so the window manager fits it to the screen instead of Chromium
# restoring a placement saved for a different screen.
# PROWL_WINDOW_SIZE=1600x900
# X display used by the headed browser inside the container.
DISPLAY=:0
